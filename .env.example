# Salin jadi .env.local lalu isi nilainya (Firebase Console → Project settings → Your apps).
# .env.local sengaja tidak ikut ter-commit; nilai yang sama harus diset juga di
# Vercel → Project Settings → Environment Variables supaya build produksi jalan.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
